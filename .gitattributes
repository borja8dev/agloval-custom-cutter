# Scripts run inside Linux containers or macOS need LF; Windows batch files need CRLF.
*.sh       text eol=lf
*.command  text eol=lf
*.bat      text eol=crlf

# Not part of the zip handed to Agloval (scripts/package-local-handoff.sh uses git archive).
.claude    export-ignore
.atl       export-ignore
odd        export-ignore
.DS_Store  export-ignore
